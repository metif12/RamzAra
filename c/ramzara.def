; ramzara.def — module-definition file for MSVC users.
; The MinGW/GCC build exports everything via -Wl,--export-all-symbols;
; MSVC users create an import library with:
;   lib /def:ramzara.def /out:ramzara.lib /machine:x64
; (dlltool from MinGW can also do it: dlltool -d ramzara.def -l ramzara.lib)
LIBRARY ramzara
EXPORTS
	ramzara_dial
	ramzara_read
	ramzara_write
	ramzara_close
	ramzara_cipher_name
	ramzara_resumed
	ramzara_listen
	ramzara_accept
	ramzara_listener_close
	ramzara_generate_self_signed
	ramzara_verify
	ramzara_cert_text
	ramzara_last_error
	ramzara_version
