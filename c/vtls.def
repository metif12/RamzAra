; vtls.def — module-definition file for MSVC users.
; The MinGW/GCC build exports everything via -Wl,--export-all-symbols;
; MSVC users create an import library with:
;   lib /def:vtls.def /out:vtls.lib /machine:x64
; (dlltool from MinGW can also do it: dlltool -d vtls.def -l vtls.lib)
LIBRARY vtls
EXPORTS
	vtls_dial
	vtls_read
	vtls_write
	vtls_close
	vtls_cipher_name
	vtls_resumed
	vtls_listen
	vtls_accept
	vtls_listener_close
	vtls_generate_self_signed
	vtls_verify
	vtls_cert_text
	vtls_last_error
	vtls_version
